# Copier ce fichier en ".env" à côté de docker-compose.yml et remplir de vraies valeurs.
# Ne jamais committer le ".env" réel (déjà exclu par .gitignore).

DB_NAME=leconsulat
DB_USER=leconsulat
# Mot de passe fort et unique — ne pas garder la valeur par défaut du docker-compose.yml.
DB_PASSWORD=change-me-strong-password

# Secret HMAC pour signer les JWT — générer une valeur aléatoire longue, par exemple :
#   openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48

# Domaine public du site (utilisé pour l'origine CORS autorisée).
FRONTEND_URL=https://votre-domaine.com
